{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jakh-site",
  "main": "src/index.js",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "jakh.net",
      "custom_domain": true
    },
    {
      "pattern": "www.jakh.net",
      "custom_domain": true
    }
    // Mail-owner approval is required before adding mta-sts.jakh.net here.
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.txt"],
      "fallthrough": true
    }
  ],
  "vars": {
    "MTA_STS_ENABLED": "false"
  },
  "observability": {
    "enabled": true
  }
}

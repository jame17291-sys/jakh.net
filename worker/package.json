{
  "name": "jakh-api",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:security": "npm audit --audit-level=high",
    "check": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.build.json",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "test:coverage": "npm run build:test && node --experimental-test-coverage '--test-coverage-include=dist/**/*.js' --test-coverage-exclude=dist/cloudflare.d.js --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=85 --test tests/*.test.mjs",
    "test:integration": "node scripts/local-integration.mjs",
    "recovery:validate": "node scripts/recovery-evidence.mjs validate",
    "recovery:readiness": "node scripts/recovery-evidence.mjs readiness",
    "recovery:bookmark": "node scripts/recovery-evidence.mjs bookmark",
    "recovery:drill": "node scripts/recovery-evidence.mjs drill",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.116.0",
    "ws": "8.21.0"
  }
}
